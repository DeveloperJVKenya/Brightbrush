rules_version = '2';

// ===============================================================
// Assumed layout
// ===============================================================
// catalog/{itemId}/{fileName}   -- catalog item photos, referenced from
//                                   CatalogItems.imageUrls in Firestore
// packages/{packageId}/{fileName} -- seasonal package photos, referenced
//                                     from Packages.imageUrl in Firestore
//
// Write access mirrors firestore.rules: gated on a Users/{uid}.role field in
// the (named) Firestore database via cross-service rules. PROTOTYPE: this
// depends on Firebase's Storage->Firestore cross-service rules support for
// this project; if a deploy ever rejects this syntax, the safe fallback is
// to gate writes on isAuthenticated() only until that's confirmed available.

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 'developer' always passes regardless of the allowed-roles list —
    // mirrors the same bypass in firestore.rules' hasStaffRole().
    function hasStaffRole(allowedRoles) {
      return isAuthenticated() &&
        firestore.exists(/databases/brightbrush-main/documents/Users/$(request.auth.uid)) &&
        (
          firestore.get(/databases/brightbrush-main/documents/Users/$(request.auth.uid)).data.role in allowedRoles ||
          firestore.get(/databases/brightbrush-main/documents/Users/$(request.auth.uid)).data.role == 'developer'
        );
    }

    function isCatalogManager() {
      return hasStaffRole(['systemManager', 'admin']);
    }

    function isAdminOrDeveloper() {
      return hasStaffRole(['admin']);
    }

    function isValidImageUpload() {
      return request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /catalog/{itemId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isCatalogManager() && isValidImageUpload();
      allow delete: if isCatalogManager();
    }

    match /packages/{packageId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isCatalogManager() && isValidImageUpload();
      allow delete: if isCatalogManager();
    }

    match /announcements/{announcementId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrDeveloper() && isValidImageUpload();
      allow delete: if isAdminOrDeveloper();
    }

    match /profiles/{uid}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) && isValidImageUpload();
      allow delete: if isOwner(uid);
    }

    function isOrderStaff() {
      return hasStaffRole(['systemManager', 'admin']);
    }

    // Customer logos: raster images for mockups, plus vector/print files
    // (SVG, PDF, AI/EPS) that production needs. Up to 25 MB.
    function isValidArtworkUpload() {
      return request.resource.size < 25 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
          request.resource.contentType in [
            'application/pdf', 'application/postscript', 'application/illustrator',
            'application/octet-stream'
          ]);
    }

    // artwork/{uid}/{artworkId}/{fileName} -- the customer's own upload,
    // referenced from Artworks/{artworkId}.fileUrl.
    match /artwork/{uid}/{artworkId}/{fileName} {
      allow read: if isOwner(uid) || isOrderStaff();
      allow create: if isOwner(uid) && isValidArtworkUpload();
      allow delete: if isOwner(uid);
    }

    // Digitized embroidery files (DST/EMB/PES...) attached by staff.
    match /artwork/{uid}/{artworkId}/digitized/{fileName} {
      allow read: if isOwner(uid) || isOrderStaff();
      allow write: if isOrderStaff() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isOrderStaff();
    }

    // Proof images staff send for approval; the order's customer can read.
    match /proofs/{orderId}/{fileName} {
      allow read: if isOrderStaff() ||
        (isAuthenticated() &&
          firestore.get(/databases/brightbrush-main/documents/Orders/$(orderId)).data.customerId == request.auth.uid);
      allow write: if isOrderStaff() && isValidImageUpload();
      allow delete: if isOrderStaff();
    }

    // Proof of delivery (handover photo, signature) by the assigned driver
    // or store staff; the order's customer can see it.
    match /pod/{orderId}/{fileName} {
      allow read: if isOrderStaff() ||
        (isAuthenticated() &&
          firestore.get(/databases/brightbrush-main/documents/Orders/$(orderId)).data.customerId == request.auth.uid);
      allow create: if isValidImageUpload() && (isOrderStaff() ||
        (isAuthenticated() &&
          firestore.get(/databases/brightbrush-main/documents/Orders/$(orderId)).data.assignedStaffId == request.auth.uid));
    }

    // Quality-check photos (store staff).
    match /qc/{orderId}/{fileName} {
      allow read: if isOrderStaff();
      allow create: if isOrderStaff() && isValidImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
